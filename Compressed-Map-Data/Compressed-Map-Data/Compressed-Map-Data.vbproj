<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Compressed_Map_Data</RootNamespace>
    <TargetFramework>net6.0</TargetFramework>
    <ImportedNamespaces>Newtonsoft.Json=False,System.Drawing=False,Microsoft.VisualBasic=True,System=True,System.Collections=True,System.Collections.Generic=True,System.Diagnostics=True,System.Linq=True,System.Xml.Linq=True,System.Threading.Tasks=True,Compressed-Map-Data=True</ImportedNamespaces>
    <Title>CMDMapLib</Title>
    <Authors>Miyu Melu</Authors>
    <Company>Miyu Melu</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="Newtonsoft.Json" />
    <Import Include="System.Drawing" />
  </ItemGroup>

</Project>
